# Copy to .env and fill in. NEVER commit the real .env.

# PostgreSQL (docker-compose.dev.yml provides this locally)
DATABASE_URL="postgresql://sala:sala_dev_password@localhost:5432/sala_dev?schema=public"
# Only for `prisma migrate dev` on a developer machine
SHADOW_DATABASE_URL="postgresql://sala:sala_dev_password@localhost:5432/sala_shadow"
# Integration tests (Vitest) — the database is wiped on every run, its name must contain "test"
TEST_DATABASE_URL="postgresql://sala:sala_dev_password@localhost:5432/sala_test"

# Auth.js — generate with:  openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the site (used for metadata / links)
APP_URL="http://localhost:3000"

# Header that carries the real client IP (for login rate limiting):
#   x-forwarded-for  → behind Nginx (default)
#   cf-connecting-ip → behind Cloudflare Tunnel
#   none             → direct access, no proxy
CLIENT_IP_HEADER="x-forwarded-for"

# Where uploaded files are stored (outside the public web root) — used from Phase 2
UPLOAD_DIR="./data/uploads"

# Shared secret for /api/cron/* jobs — used from Phase 4
CRON_SECRET=""
